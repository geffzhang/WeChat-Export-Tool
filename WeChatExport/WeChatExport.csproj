<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <Version>2.0.0</Version>

    <!-- Self-contained single-file release (dotnet publish -c Release) -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!-- Don't ship debug symbols in the release package -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!-- QuestPDF's package ships a LatoFont/ folder (19 .ttf files) as None items
       copied to the output and publish directories, via its own QuestPDF.targets.
       "Lato" is QuestPDF's default font FAMILY NAME, resolved from disk when the
       folder is present; it is not an embedded font (QuestPDF.dll contains the
       string "Lato" once, and no LatoFont/Lato-Regular font data). This app does
       not select that family - Avalonia renders with Inter, and the PDF export
       never asks for Lato - so the folder is dead weight. Verified by rendering a
       PDF with the folder absent. Dropped here before the copy targets see them;
       it otherwise doubles the size of the shipped folder beside the single-file
       exe. -->
  <Target Name="RemoveUnusedQuestPdfFonts" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <None Remove="@(None)"
            Condition="$([System.String]::Copy('%(None.Link)').StartsWith('LatoFont'))" />
    </ItemGroup>
  </Target>

  <!-- Native packages (SkiaSharp, HarfBuzz) ship large .pdb symbols that a
       release package does not need. -->
  <Target Name="RemovePdbsFromPublish" AfterTargets="Publish">
    <ItemGroup>
      <PdbsToDelete Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(PdbsToDelete)" />
  </Target>

  <!-- wx_key.dll is the native hook that captures WeChat's SQLCipher key. It
       cannot be reimplemented in managed code, so it ships as a plain native
       library and is loaded by Core/Decryption/WxKeyInterop.cs via DllImport.
       It is copied to the output ROOT, not a subfolder, because DllImport
       resolves against the application directory.
       x64 only, matching <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>.

       ExcludeFromSingleFile is load-bearing, not cosmetic. Without it the
       publish bundles this DLL into the single-file exe, and
       IncludeNativeLibrariesForSelfExtract then extracts it at RUNTIME to
       %TEMP%\.net\WeChatExport\<dir>\ - a directory the logged-in user can
       write. The process that loads it is the elevated key-capture child, so
       that would have an administrator process loading a native library from a
       user-writable path. Keeping it a real file beside the exe means it is
       loaded from the application directory instead. Verified: after this
       change the publish directory contains wx_key.dll as a loose file and the
       published exe no longer resolves it out of %TEMP%. -->
  <ItemGroup>
    <None Include="..\dll\wx_key.dll"
          Link="wx_key.dll"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <!-- Microsoft.Data.Sqlite.Core (not the Microsoft.Data.Sqlite metapackage) so
         the SQLite native provider is chosen explicitly: WeChat's MSG*.db files are
         SQLCipher v4 databases, and the default bundle_e_sqlite3 build of SQLite
         cannot read them at all. See Services/DatabaseService.cs for how the key is
         applied. -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="8.0.11" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.11" />
    <PackageReference Include="ClosedXML" Version="0.104.1" />
    <PackageReference Include="QuestPDF" Version="2026.2.0" />
    <!-- WeChat 4.x stores some message content zstd-compressed (the row's
         WCDB_CT_message_content is 4). ZstdSharp.Port is a pure managed port with no
         native dependency, so it neither complicates the self-contained single-file
         publish nor adds a second native SQLite/Skia payload. See
         DatabaseService.ReadContent. -->
    <PackageReference Include="ZstdSharp.Port" Version="0.8.1" />
    <PackageReference Include="Serilog" Version="4.1.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>
</Project>
